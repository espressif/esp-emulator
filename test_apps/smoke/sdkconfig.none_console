# Variant: no primary console, USB-Serial-JTAG as the secondary (ESP-Mosaico's
# configuration). Every stdout byte goes out over EP1 only; ROM printing is off.
# Layered on top of sdkconfig.defaults by tests/test_app_smoke.rs via
# -DSDKCONFIG_DEFAULTS; the per-target sdkconfig.defaults.<chip> files still
# apply.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
