# Variant: the ROM's CDC-ACM driver on USB-OTG as the primary console
# (CONFIG_ESP_CONSOLE_USB_CDC, ESP32-S3), with the default USB-Serial-JTAG
# secondary. The ROM driver runs the DWC2 core in slave mode, and the two
# consoles share one PHY. Layered on top of sdkconfig.defaults by
# tests/test_app_smoke.rs via -DSDKCONFIG_DEFAULTS; the per-target
# sdkconfig.defaults.<chip> files still apply.
CONFIG_ESP_CONSOLE_USB_CDC=y
